{
  "name": "bid-house",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && node scripts/copy-static.mjs",
    "start": "node dist/server/server.js",
    "dev": "npm run build && concurrently \"tsc --watch\" \"node --watch dist/server/server.js\"",
    "smoke": "npm run build && node dist/smoke/smoke.js",
    "verify-assets": "node scripts/verify-assets.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "concurrently": "^9.1.0",
    "playwright": "^1.63.0",
    "typescript": "^5.7.2"
  }
}
